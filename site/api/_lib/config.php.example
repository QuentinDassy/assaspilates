<?php
/**
 * Copy this file to config.php, fill in real values, and upload it to the
 * server via FTP (one-time, and again whenever a secret rotates).
 *
 * config.php is NEVER committed to git (see .gitignore) and OVH's native Git
 * deploy never sees it either — it holds secrets that must never reach a
 * browser or a git history. It sits inside the web root but, like
 * WordPress's wp-config.php on this same hosting, Apache executes it as PHP
 * rather than serving its source.
 */

return [
    // Supabase project settings — Project Settings -> API in the Supabase dashboard
    'SUPABASE_URL' => 'https://xxxxxxxxxxxx.supabase.co',
    'SUPABASE_ANON_KEY' => 'eyJ...',              // safe to expose to the browser
    'SUPABASE_SERVICE_ROLE_KEY' => 'eyJ...',      // NEVER expose to the browser -- server-only
    // No JWT secret needed -- this project signs with an asymmetric key, verified
    // against Supabase's public JWKS (site/api/_lib/auth.php fetches it directly).

    // Stripe -- Developers -> API keys (use test keys until Phase 5 go-live)
    'STRIPE_SECRET_KEY' => 'sk_test_...',
    'STRIPE_PUBLISHABLE_KEY' => 'pk_test_...',
    'STRIPE_WEBHOOK_SECRET' => 'whsec_...',       // Developers -> Webhooks -> the endpoint's signing secret

    // Leave unset on OVH. Only needed locally if something on your machine
    // does TLS interception (e.g. an antivirus like Avast) -- the Stripe SDK
    // ignores php.ini's curl.cainfo and needs this override instead
    // (site/api/_lib/stripe_client.php). Point it at a CA bundle that
    // includes your interceptor's root certificate.
    // 'STRIPE_CA_BUNDLE_PATH' => 'C:/path/to/augmented-cacert.pem',
];
