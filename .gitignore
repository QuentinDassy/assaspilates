# Local Netlify folder
.netlify

# Local Claude Code environment/permission settings (machine-specific, not project config)
.claude/

# PHP backend secrets (never committed -- see site/api/_lib/config.php.example)
/site/api/_lib/config.php
# site/api/vendor/ IS committed -- OVH's native Git deploy has no build step
# (no SSH to run `composer install` server-side), so the built dependencies
# have to ship with the repo. See composer.json.

# Supabase CLI local state
/supabase/.temp/
/supabase/.branches/
